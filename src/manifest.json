{
  "manifest_version": 3,
  "name": "Ephemeral",
  "version": "2.4.0",
  "description": "Private, self-cleaning Firefox containers for temporary browsing - transparent, bounded cleanup, fully offline.",
  "homepage_url": "https://github.com/mheci/Ephemeral",
  "browser_specific_settings": {
    "gecko": {
      "id": "ephemeral@mheci.github.io",
      "strict_min_version": "153.0",
      "update_url": "https://mheci.github.io/Ephemeral/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "alarms",
    "browsingData",
    "contextualIdentities",
    "cookies",
    "storage",
    "menus"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_title": "Ephemeral disposable containers",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    },
    "theme_icons": [
      {
        "light": "icons/toolbar-light-32.png",
        "dark": "icons/toolbar-dark-32.png",
        "size": 32
      }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Open Ephemeral"
    },
    "open-ephemeral-tab": {
      "suggested_key": {
        "default": "Ctrl+Alt+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Open new ephemeral tab"
    },
    "open-ephemeral-space": {
      "suggested_key": {
        "default": "Ctrl+Alt+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Open new ephemeral space"
    },
    "open-ephemeral-window": {
      "description": "Open new ephemeral window"
    },
    "panic-clean": {
      "description": "Panic clean – arm the wipe of every active session"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "incognito": "not_allowed"
}
